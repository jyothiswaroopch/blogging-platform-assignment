# ===============================================
# Java & Maven
# ===============================================

# Compiled class files
*.class

# Compiled jar/war/ear files
*.jar
*.war
*.ear

# Maven target directory (this is the most important one)
# This ignores all build outputs, compiled code, and test reports.
target/

# Log files
*.log

# JVM crash logs
hs_err_pid*
replay_pid*

# Maven release files
release.properties
dependency-reduced-pom.xml
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.tag

# ===============================================
# IDE Files
# ===============================================

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.project
.classpath
.settings/

# VS Code
.vscode/

